{
  "name": "@zhangj1164/dsh-github-issue",
  "description": "GitHub issue generation, filing, and intake service for DeepSeek Harness: structured reports from telemetry analysis, AI-optimized descriptions, direct issue creation, and first-startup dispatch of claimable issues to new Sessions",
  "version": "0.2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangj1164/dsh-mega-plugins.git",
    "directory": "packages/github-issue/dsh-github-issue"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@types/node": "^26.5.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}