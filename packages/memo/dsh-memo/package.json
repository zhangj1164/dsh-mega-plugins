{
  "name": "@zhangj1164/dsh-memo",
  "description": "Local-only week-keyed personal memo service for DeepSeek Harness with AI analysis, report export, telemetry logging, GitHub issue generation, and archived-session summaries",
  "version": "0.6.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "memo",
    "notes"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./llm-text": {
      "types": "./lib/llm-text.d.ts",
      "default": "./lib/llm-text.js"
    },
    "./period": {
      "types": "./lib/period.d.ts",
      "default": "./lib/period.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "prepublishOnly": "node ../../../scripts/publish-guard.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangj1164/dsh-mega-plugins.git",
    "directory": "packages/memo/dsh-memo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.6",
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@zhangj1164/dsh-client-ui-memo": "workspace:^",
    "@zhangj1164/dsh-github-issue": "workspace:^",
    "@zhangj1164/dsh-telemetry": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-json": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.2",
    "@types/node": "^26.5.1",
    "@zhangj1164/dsh-client-ui-memo": "workspace:*",
    "@zhangj1164/dsh-github-issue": "workspace:*",
    "@zhangj1164/dsh-telemetry": "workspace:*",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
