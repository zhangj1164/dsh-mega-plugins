          "resource": "repo://packages/github-issue/dsh-github-issue/src/github.ts#L1-L10",
          "version": "repo-lines-v1:sha256:a30ccb2ab5abbe8ad3addd41e25bf1847edff56ba82a0440916bc2540e80308b:"
