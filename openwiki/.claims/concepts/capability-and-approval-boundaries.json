    {
      "id": "claim_40e0c6a713694fd89a3b694b8fdbd78c",
      "statement": "Approval is structurally unavailable to panel-initiated Remote calls: ctx.approval.request() requires an open turn and an agent, and the approval/asked + approval/decided pair is the unit a turn commits and replays, so a click arriving between turns cannot be confirmed even when the caller can obtain the agent.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L99-L99",
          "version": "repo-lines-v1:sha256:6b3c7eccd2fdb232f9936a18d35a3535b5881dae209862daa2b5f71ffbd67146:"
        },
        {
